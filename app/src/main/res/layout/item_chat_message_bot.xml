<?xml version="1.0" encoding="utf-8"?>
<!-- A chat bubble for a message from the AI assistant (left side, light). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_bot"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:textColor="@color/chat_text_dark"
        android:textSize="14sp"
        tools:text="Enable two-factor authentication: it adds a second step when you log in." />
</LinearLayout>
